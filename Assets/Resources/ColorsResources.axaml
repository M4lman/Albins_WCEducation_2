<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <Color x:Key="PrimaryForegroundColor">#EAE8E8</Color>
  <Color x:Key="PrimaryBackgroundColor">#04041F</Color>
  <Color x:Key="DangerColor">#940202</Color>
  <Color x:Key="SuccessColor">#2E9B58</Color>
  <Color x:Key="SecondaryBackgroundColor">#151E3E</Color>
  <Color x:Key="WarningColor">#F45906</Color>
  <Color x:Key="InputBackgroundColor">#04041F</Color>
  <Color x:Key="FormBackgroundColor">#151E3E</Color>
  <Color x:Key="ControlBorderColor">#4472F2</Color>
  <Color x:Key="ButtonHoverColor">#060681</Color>
</ResourceDictionary>
