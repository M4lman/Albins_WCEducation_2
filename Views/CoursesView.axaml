<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Client.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="Våra Kurser"/>
    <Button HorizontalAlignment="Left" Classes="form" MaxWidth="300" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddCourseCommand}">
      <StackPanel Orientation="Horizontal">
        <Label FontFamily="{DynamicResource IconFont}" Content="&#xe3d4;" Padding="0 5 5 0"/>
        <Label Content="Lägg till kurs"/>
      </StackPanel>
    </Button>

    <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0 0 0 1" Padding="0 50 0 5">
      <Grid ColumnDefinitions="100,250,150,150,100,80,80" ShowGridLines="True">
        <Label Grid.Column="0" Content="Kursnr" />
        <Label Grid.Column="1" Content="Kursnamn" />
        <Label Grid.Column="2" Content="Startdatum" />
        <Label Grid.Column="3" Content="Slutdatum" />
        <Label Grid.Column="4" Content="Längd" />
        <Label Grid.Column="5" Content="" />
        <Label Grid.Column="6" Content="" />
      </Grid>
    </Border>
    <ScrollViewer Height="400">
      <ItemsControl ItemsSource="{Binding Courses}" Margin="0 10 0 0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,250,150,150,100,80,80" ShowGridLines="False">
              <Label Grid.Column="0" Content="{Binding CourseNumber}" />
              <Label Grid.Column="1" Content="{Binding Title}" />
              <Label Grid.Column="2" Content="{Binding StartDate}" />
              <Label Grid.Column="3" Content="{Binding EndDate}" />
              <Label Grid.Column="4" Content="{Binding Length}" HorizontalAlignment="Left" />
              <Button Grid.Column="5" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToEditCourseCommand}" CommandParameter="{Binding CourseNumber}" FontFamily="{DynamicResource IconFont}" Content="&#xebc6;" Foreground="{DynamicResource Success}" Padding="15 5"></Button>
              <Button Classes="danger" Grid.Column="6" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding CourseNumber}" FontFamily="{DynamicResource IconFont}" Content="&#xe4a6;" Foreground="{DynamicResource Danger}" Padding="15 5"></Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>


  </StackPanel>
</UserControl>
